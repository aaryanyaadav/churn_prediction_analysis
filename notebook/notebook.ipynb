  {
   "cell_type": "markdown",
   "id": "4bc6b3f1",
   "metadata": {},
   "source": [
    "use the train papremeters to do the one hot enencoding for both test and train data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 143,
   "id": "29dd79fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import OneHotEncoder\n",
    "\n",
    "encoder = OneHotEncoder(\n",
    "    handle_unknown=\"ignore\",\n",
    "    sparse_output=False\n",
    ")\n",
    "\n",
    "# Fit on X_train categorical columns and transform X_train\n",
    "train_encoded = encoder.fit_transform(\n",
    "    X_train[[\"Geography\", \"Gender\"]]\n",
    ")\n",
    "\n",
    "# Transform X_test using the same encoder\n",
    "test_encoded = encoder.transform(\n",
    "    X_test[[\"Geography\", \"Gender\"]]\n",
    ")\n",
    "\n",
    "# Get the new column names\n",
    "encoded_columns = encoder.get_feature_names_out(\n",
    "    [\"Geography\", \"Gender\"]\n",
    ")\n",
    "\n",
    "# Remove original categorical columns\n",
    "X_train = X_train.drop(columns=[\"Geography\", \"Gender\"])\n",
    "X_test = X_test.drop(columns=[\"Geography\", \"Gender\"])\n",
    "\n",
    "# Add the encoded columns directly\n",
    "X_train[encoded_columns] = train_encoded\n",
    "X_test[encoded_columns] = test_encoded"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 144,
   "id": "eb10cb75",
   "metadata": {},
   "outputs": [],
   "source": [
    "with open(\"encoder.pkl\", \"wb\") as file:\n",
    "    pickle.dump(encoder, file)"
   ]
  },
