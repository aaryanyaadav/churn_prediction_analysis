  {
   "cell_type": "markdown",
   "id": "480c4fe0",
   "metadata": {},
   "source": [
    "do the scaing with the help of the parameters from the train and then apply on both test and train "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 148,
   "id": "90e14b57",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "columns_to_scale = [\n",
    "    \"CreditScore\",\n",
    "    \"Age\",\n",
    "    \"Tenure\",\n",
    "    \"Balance\",\n",
    "    \"EstimatedSalary\",\n",
    "    \"BalancePerProduct\"\n",
    "]\n",
    "\n",
    "scaler = StandardScaler()\n",
    "\n",
    "# Fit ONLY on X_train\n",
    "scaler.fit(X_train[columns_to_scale])\n",
    "\n",
    "# Transform X_train\n",
    "X_train[columns_to_scale] = scaler.transform(\n",
    "    X_train[columns_to_scale]\n",
    ")\n",
    "\n",
    "# Transform X_test using the same fitted scaler\n",
    "X_test[columns_to_scale] = scaler.transform(\n",
    "    X_test[columns_to_scale]\n",
    ")"
   ]
  },
